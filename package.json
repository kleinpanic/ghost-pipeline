{
  "name": "ghost-pipeline",
  "version": "3.0.0",
  "description": "Klein's iMessage auto-reply pipeline via BlueBubbles MCP",
  "main": "src/ghost.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/ghost.js serve",
    "lint": "eslint .",
    "test": "jest --coverage",
    "test:unit": "jest tests/unit --coverage",
    "test:integration": "jest tests/integration",
    "e2e": "FORCE=1 jest tests/e2e --runInBand --forceExit",
    "status": "node src/ghost.js status",
    "pause": "node src/ghost.js pause",
    "resume": "node src/ghost.js resume"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "nock": "^13.5.6"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "sqlite-vec": "^0.1.7"
  }
}
