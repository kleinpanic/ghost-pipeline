# Ghost Pipeline Configuration
# Copy to .env and fill in your values

# BlueBubbles server
BB_HOST=10.0.0.100
BB_PORT=1234

# Ghost webhook server port and bind address
GHOST_PORT=18790
# GHOST_BIND_HOST=0.0.0.0

# Shared secret for the HTTP API (strongly recommended). Append ?token=<value> to the
# BlueBubbles webhook URL; remote callers of /action etc. send it as a Bearer token.
GHOST_API_TOKEN=

# Discord channel for ghost drafts
GHOST_CHANNEL_ID=

# Owner phone number (normalized, no +)
OWNER_PHONE=

# Klein's Discord user ID (optional — restricts button clicks to this user)
KLEIN_DISCORD_USER_ID=

# Secrets (alternative to file-based secrets in ~/.config/)
# OPENROUTER_API_KEY=
# DISCORD_BOT_TOKEN=
# BB_PASSWORD=
# GEMINI_API_KEY=
# SPARK_API_KEY=
# OC_GATEWAY_TOKEN=

# Spark vLLM — the local DGX, used for drafting AND for `ghost learn`.
# SPARK_VLLM_HOST/PORT were never read by the code; SPARK_BASE_URL is the real knob.
# Reached over the wg-nvidia plane: 10.88.88.1, NOT 10.99.1.1 (which has no route there).
# Leave unset to accept the in-code default, which points at the same address.
# SPARK_BASE_URL=http://10.88.88.1:18080/v1
#
# The deployment serves ONE chat model; `any` is the router's alias for it. Pinning a
# concrete model id is how the learn path died once already — prefer the alias.
# SPARK_MODEL_FAST=any
# SPARK_MODEL_STRONG=any
#
# Model used by `ghost learn` for contact summaries and the voice profile.
# GHOST_LEARN_MODEL=any

# Paths (defaults work for standard OpenClaw installs)
# GHOST_WORKSPACE=~/.openclaw/workspace-ghost
# GHOST_DATA_DIR=~/.openclaw/data
# GHOST_CONTACTS_MEMORY_DIR=~/.openclaw/workspace-ghost/memory/contacts
